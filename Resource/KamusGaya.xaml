<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ========================================
         WARNA (SOLID COLORS)
         ======================================== -->
    
    <!-- Warna latar belakang utama -->
    <SolidColorBrush x:Key="WarnaLatar" Color="#F5F7FA"/>
    
    <!-- Warna teks utama -->
    <SolidColorBrush x:Key="WarnaTeks" Color="#2C3E50"/>
    
    <!-- Warna tombol utama -->
    <SolidColorBrush x:Key="WarnaTombol" Color="#3498DB"/>
    
    <!-- Warna tombol hover -->
    <SolidColorBrush x:Key="WarnaTombolHover" Color="#2980B9"/>
    
    <!-- Warna latar abu-abu -->
    <SolidColorBrush x:Key="WarnaAbu" Color="#ECF0F1"/>
    
    <!-- Warna card -->
    <SolidColorBrush x:Key="WarnaCard" Color="#FFFFFF"/>
    
    <!-- Warna border -->
    <SolidColorBrush x:Key="WarnaBorder" Color="#BDC3C7"/>
    
    <!-- Warna teks error -->
    <SolidColorBrush x:Key="WarnaTeksError" Color="#E74C3C"/>
    
    <!-- Warna success -->
    <SolidColorBrush x:Key="WarnaSuccess" Color="#27AE60"/>
    
    <!-- Warna accent -->
    <SolidColorBrush x:Key="WarnaAccent" Color="#9B59B6"/>

    <!-- ========================================
         UKURAN FONT
         ======================================== -->
    
    <!-- Ukuran font normal -->
    <sys:Double x:Key="UkuranFontNormal">14</sys:Double>
    
    <!-- Ukuran font besar -->
    <sys:Double x:Key="UkuranFontBesar">18</sys:Double>

    <!-- ========================================
         SPACING (MARGIN & PADDING)
         ======================================== -->
    
    <!-- Margin standar -->
    <Thickness x:Key="MarginStandar">8</Thickness>
    
    <!-- Padding standar -->
    <Thickness x:Key="PaddingStandar">8</Thickness>
    
    <!-- Margin untuk seksi -->
    <Thickness x:Key="MarginSeksi">16</Thickness>
    
    <!-- Padding untuk window -->
    <Thickness x:Key="PaddingWindow">16</Thickness>


    <!-- ========================================
         STYLES
         ======================================== -->

    <!-- Style untuk Button -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WarnaTombol}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranFontNormal}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarnaTombolHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style untuk TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="BorderBrush" Value="{StaticResource WarnaBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource WarnaTombol}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style untuk ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarnaBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="White"/>
    </Style>

    <!-- Style untuk ListBox -->
    <Style TargetType="ListBox">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Style untuk ListBoxItem -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{StaticResource WarnaCard}"
                            BorderBrush="{StaticResource WarnaBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20,16"
                            Margin="{TemplateBinding Margin}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" 
                                              Opacity="0.1" 
                                              BlurRadius="10" 
                                              ShadowDepth="2" 
                                              Direction="270"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarnaAbu}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style untuk TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UkuranFontNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource WarnaTeks}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
