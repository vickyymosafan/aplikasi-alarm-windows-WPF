<Window x:Class="AplikasiAlarmWindows.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aplikasi Alarm Windows"
        Width="800"
        Height="600"
        MinWidth="800"
        MinHeight="600">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AplikasiAlarmWindows;component/Resource/KamusGaya.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converter untuk boolean to visibility -->
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="{StaticResource PaddingWindow}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Waktu realtime -->
            <RowDefinition Height="Auto"/> <!-- Input section -->
            <RowDefinition Height="Auto"/> <!-- Validation message -->
            <RowDefinition Height="*"/>    <!-- Alarm list -->
            <RowDefinition Height="Auto"/> <!-- Control buttons -->
        </Grid.RowDefinitions>
        
        <!-- ========================================
             WAKTU REALTIME (Row 0)
             ======================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource WarnaAbu}"
                Padding="12"
                Margin="{StaticResource MarginStandar}"
                CornerRadius="4">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <TextBlock Text="🕐 "
                           FontSize="18"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding WaktuSekarang}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{StaticResource WarnaTombol}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- ========================================
             INPUT SECTION (Row 1)
             ======================================== -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource MarginStandar}">
            
            <!-- Label Jam -->
            <TextBlock Text="Jam:"
                       VerticalAlignment="Center"/>
            
            <!-- Input Jam -->
            <TextBox Text="{Binding JamInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="8,0,0,0"/>
            
            <!-- Label Menit -->
            <TextBlock Text="Menit:"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
            
            <!-- Input Menit -->
            <TextBox Text="{Binding MenitInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="8,0,0,0"/>
            
            <!-- Label Suara -->
            <TextBlock Text="Suara:"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
            
            <!-- Pilihan Suara -->
            <ComboBox ItemsSource="{Binding DaftarFileSuara}"
                      SelectedItem="{Binding FileSuaraTerpilih, Mode=TwoWay}"
                      Width="150"
                      Height="32"
                      Margin="8,0,0,0"
                      VerticalContentAlignment="Center"/>
            
            <!-- Tombol Tambah Alarm -->
            <Button Content="Tambah Alarm"
                    Command="{Binding TambahAlarmCommand}"
                    Margin="16,0,0,0"/>
        </StackPanel>
        
        <!-- ========================================
             VALIDATION MESSAGE (Row 2)
             ======================================== -->
        <TextBlock Grid.Row="2"
                   Text="{Binding PesanValidasi}"
                   Foreground="{StaticResource WarnaTeksError}"
                   Margin="{StaticResource MarginStandar}"
                   TextWrapping="Wrap"/>
        
        <!-- ========================================
             ALARM LIST (Row 3)
             ======================================== -->
        <ListBox Grid.Row="3"
                 ItemsSource="{Binding DaftarAlarm}"
                 Margin="{StaticResource MarginStandar}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Waktu alarm -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding}"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                        
                        <!-- Nama file suara -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding NamaFileSuara, StringFormat=' - {0}'}"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Margin="4,0,0,0"/>
                        
                        <!-- Status aktif -->
                        <TextBlock Grid.Column="2"
                                   Text="🔔 Aktif"
                                   Foreground="{StaticResource WarnaTeksError}"
                                   FontWeight="Bold"
                                   Margin="16,0,8,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsAktif, Converter={StaticResource BoolToVisConverter}}"/>
                        
                        <!-- Tombol Hapus -->
                        <Button Grid.Column="3"
                                Content="🗑️ Hapus"
                                Command="{Binding DataContext.HapusAlarmCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Background="#D13438"
                                Foreground="White"
                                MinWidth="80"
                                Height="28"
                                Margin="8,0,0,0"
                                FontSize="12"
                                Cursor="Hand"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- ========================================
             CONTROL BUTTONS (Row 4)
             ======================================== -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="{StaticResource MarginStandar}">
            
            <!-- Tombol Stop Alarm -->
            <Button Content="Stop Alarm"
                    Command="{Binding StopAlarmCommand}"/>
        </StackPanel>
        
    </Grid>
    
</Window>
