<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ========================================
         WARNA (SOLID COLORS) - Black & White Theme
         ======================================== -->
    
    <!-- Base Colors -->
    <SolidColorBrush x:Key="WarnaLatar" Color="#FFFFFF"/>        <!-- white background -->
    <SolidColorBrush x:Key="WarnaTeks" Color="#000000"/>         <!-- black text -->
    
    <!-- Aliases for semantic naming -->
    <StaticResource x:Key="WarnaCard" ResourceKey="WarnaLatar"/>
    <StaticResource x:Key="WarnaCardForeground" ResourceKey="WarnaTeks"/>
    
    <!-- Primary -->
    <SolidColorBrush x:Key="WarnaPrimary" Color="#000000"/>      <!-- black primary -->
    <SolidColorBrush x:Key="WarnaPrimaryForeground" Color="#FFFFFF"/>
    
    <!-- Accent -->
    <SolidColorBrush x:Key="WarnaAccent" Color="#E0E0E0"/>       <!-- light gray accent -->
    <StaticResource x:Key="WarnaAccentForeground" ResourceKey="WarnaTeks"/>
    
    <!-- Destructive -->
    <StaticResource x:Key="WarnaDestructive" ResourceKey="WarnaLatar"/>
    <StaticResource x:Key="WarnaDestructiveForeground" ResourceKey="WarnaTeks"/>
    
    <!-- Border -->
    <StaticResource x:Key="WarnaBorder" ResourceKey="WarnaPrimary"/>
    
    <!-- Button -->
    <StaticResource x:Key="WarnaTombol" ResourceKey="WarnaPrimary"/>
    <SolidColorBrush x:Key="WarnaTombolHover" Color="#333333"/>
    
    <!-- Text -->
    <SolidColorBrush x:Key="WarnaTeksSecondary" Color="#666666"/>

    <!-- ========================================
         UKURAN FONT
         ======================================== -->
    
    <!-- Ukuran font -->
    <sys:Double x:Key="UkuranFontKecil">12</sys:Double>
    <sys:Double x:Key="UkuranFontNormal">16</sys:Double>
    <sys:Double x:Key="UkuranFontBesar">20</sys:Double>
    <sys:Double x:Key="UkuranFontJumbo">48</sys:Double>
    <sys:Double x:Key="UkuranFontMega">72</sys:Double>

    <!-- ========================================
         SPACING (MARGIN & PADDING)
         ======================================== -->
    
    <!-- Margin standar -->
    <Thickness x:Key="MarginStandar">8</Thickness>
    
    <!-- Padding standar -->
    <Thickness x:Key="PaddingStandar">8</Thickness>
    
    <!-- Margin untuk seksi -->
    <Thickness x:Key="MarginSeksi">16</Thickness>
    
    <!-- Padding untuk window -->
    <Thickness x:Key="PaddingWindow">16</Thickness>


    <!-- ========================================
         STYLES
         ======================================== -->

    <!-- Style untuk Button -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WarnaPrimary}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" 
                                              Opacity="0.15" 
                                              BlurRadius="12" 
                                              ShadowDepth="2"/>
                        </Border.Effect>
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="#FFFFFF"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarnaTombolHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>

    <!-- Style untuk TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="BorderBrush" Value="{StaticResource WarnaBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#333333"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style untuk ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderBrush" Value="#000000"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Grid.Column="0"
                                      Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                              Margin="12,0,0,0"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                            <Path Grid.Column="1"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#000000"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderBrush" Value="#000000"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,0,32,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          TextBlock.Foreground="#000000"
                                          TextBlock.FontWeight="Bold"
                                          TextBlock.FontSize="20"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="300">
                                <Border Background="#FFFFFF"
                                        BorderBrush="#000000"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="16" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Style untuk ComboBoxItem -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="#FFFFFF"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="6"
                            Margin="2">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="#000000"
                                          TextBlock.FontWeight="Bold"
                                          TextBlock.FontSize="18"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#E0E0E0"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#D0D0D0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style untuk ListBox -->
    <Style TargetType="ListBox">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Style untuk ListBoxItem -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="#FFFFFF"
                            BorderBrush="#000000"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="20,16"
                            Margin="{TemplateBinding Margin}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" 
                                              Opacity="0.1" 
                                              BlurRadius="10" 
                                              ShadowDepth="2" 
                                              Direction="270"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F5F5F5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style untuk TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UkuranFontNormal}"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
