<Window x:Class="AplikasiAlarmWindows.View.NotifikasiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarm Aktif"
        WindowStyle="None"
        Topmost="True"
        Width="300"
        Height="150"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WarnaTombol}">
    
    <Window.Resources>
        <ResourceDictionary Source="/Resource/KamusGaya.xaml"/>
    </Window.Resources>
    
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Orientation="Vertical">
            <!-- Judul notifikasi -->
            <TextBlock Text="Alarm Aktif!"
                       FontSize="{StaticResource UkuranFontBesar}"
                       Foreground="White"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>
            
            <!-- Waktu alarm -->
            <TextBlock Text="{Binding}"
                       FontSize="{StaticResource UkuranFontBesar}"
                       Foreground="White"
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
    
</Window>
