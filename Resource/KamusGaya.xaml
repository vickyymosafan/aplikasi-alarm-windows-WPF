<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ========================================
         WARNA (SOLID COLORS)
         ======================================== -->
    
    <!-- Warna latar belakang utama -->
    <SolidColorBrush x:Key="WarnaLatar" Color="#FFFFFF"/>
    
    <!-- Warna teks utama -->
    <SolidColorBrush x:Key="WarnaTeks" Color="#000000"/>
    
    <!-- Warna tombol utama -->
    <SolidColorBrush x:Key="WarnaTombol" Color="#0078D4"/>
    
    <!-- Warna latar abu-abu -->
    <SolidColorBrush x:Key="WarnaAbu" Color="#F0F0F0"/>
    
    <!-- Warna border -->
    <SolidColorBrush x:Key="WarnaBorder" Color="#CCCCCC"/>
    
    <!-- Warna teks error -->
    <SolidColorBrush x:Key="WarnaTeksError" Color="#D13438"/>

    <!-- ========================================
         UKURAN FONT
         ======================================== -->
    
    <!-- Ukuran font normal -->
    <sys:Double x:Key="UkuranFontNormal">14</sys:Double>
    
    <!-- Ukuran font besar -->
    <sys:Double x:Key="UkuranFontBesar">18</sys:Double>

    <!-- ========================================
         SPACING (MARGIN & PADDING)
         ======================================== -->
    
    <!-- Margin standar -->
    <Thickness x:Key="MarginStandar">8</Thickness>
    
    <!-- Padding standar -->
    <Thickness x:Key="PaddingStandar">8</Thickness>
    
    <!-- Margin untuk seksi -->
    <Thickness x:Key="MarginSeksi">16</Thickness>
    
    <!-- Padding untuk window -->
    <Thickness x:Key="PaddingWindow">16</Thickness>


    <!-- ========================================
         STYLES
         ======================================== -->

    <!-- Style untuk Button -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WarnaTombol}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranFontNormal}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Style untuk TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="BorderBrush" Value="{StaticResource WarnaBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontSize" Value="{StaticResource UkuranFontNormal}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Style untuk ListBox -->
    <Style TargetType="ListBox">
        <Setter Property="BorderBrush" Value="{StaticResource WarnaBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource WarnaLatar}"/>
    </Style>

    <!-- Style untuk ListBoxItem -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="{StaticResource MarginStandar}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Style untuk TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UkuranFontNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource WarnaTeks}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
