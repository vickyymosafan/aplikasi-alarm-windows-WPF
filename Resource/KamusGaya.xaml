<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ========================================
         WARNA (SOLID COLORS) - Dark Theme
         Based on provided color scheme
         ======================================== -->
    
    <!-- Background & Foreground -->
    <SolidColorBrush x:Key="WarnaLatar" Color="#2B3440"/>        <!-- dark background -->
    <SolidColorBrush x:Key="WarnaTeks" Color="#F7F8F9"/>         <!-- dark foreground -->
    
    <!-- Card -->
    <SolidColorBrush x:Key="WarnaCard" Color="#3D4754"/>         <!-- dark card -->
    <SolidColorBrush x:Key="WarnaCardForeground" Color="#F7F8F9"/>
    
    <!-- Primary -->
    <SolidColorBrush x:Key="WarnaPrimary" Color="#C74B3D"/>      <!-- primary -->
    <SolidColorBrush x:Key="WarnaPrimaryForeground" Color="#FAF9F8"/>
    
    <!-- Secondary -->
    <SolidColorBrush x:Key="WarnaSecondary" Color="#C89A4A"/>    <!-- secondary -->
    <SolidColorBrush x:Key="WarnaSecondaryForeground" Color="#F5EDD9"/>
    
    <!-- Muted -->
    <SolidColorBrush x:Key="WarnaMuted" Color="#2E3642"/>        <!-- muted -->
    <SolidColorBrush x:Key="WarnaMutedForeground" Color="#D9DCDF"/>
    
    <!-- Accent -->
    <SolidColorBrush x:Key="WarnaAccent" Color="#D6A84F"/>       <!-- accent -->
    <SolidColorBrush x:Key="WarnaAccentForeground" Color="#F5EDD9"/>
    
    <!-- Destructive -->
    <SolidColorBrush x:Key="WarnaDestructive" Color="#E17A5F"/>  <!-- destructive -->
    <SolidColorBrush x:Key="WarnaDestructiveForeground" Color="#FFFFFF"/>
    
    <!-- Border & Input -->
    <SolidColorBrush x:Key="WarnaBorder" Color="#545E6C"/>       <!-- border -->
    <SolidColorBrush x:Key="WarnaInput" Color="#545E6C"/>
    
    <!-- Legacy compatibility -->
    <SolidColorBrush x:Key="WarnaTombol" Color="#C74B3D"/>
    <SolidColorBrush x:Key="WarnaTombolHover" Color="#B03D2F"/>
    <SolidColorBrush x:Key="WarnaTeksSecondary" Color="#D9DCDF"/>
    <SolidColorBrush x:Key="WarnaTeksError" Color="#E17A5F"/>
    <SolidColorBrush x:Key="WarnaSuccess" Color="#C89A4A"/>
    <SolidColorBrush x:Key="WarnaAbu" Color="#3D4754"/>

    <!-- ========================================
         UKURAN FONT
         ======================================== -->
    
    <!-- Ukuran font -->
    <sys:Double x:Key="UkuranFontKecil">12</sys:Double>
    <sys:Double x:Key="UkuranFontNormal">16</sys:Double>
    <sys:Double x:Key="UkuranFontBesar">20</sys:Double>
    <sys:Double x:Key="UkuranFontJumbo">48</sys:Double>
    <sys:Double x:Key="UkuranFontMega">72</sys:Double>

    <!-- ========================================
         SPACING (MARGIN & PADDING)
         ======================================== -->
    
    <!-- Margin standar -->
    <Thickness x:Key="MarginStandar">8</Thickness>
    
    <!-- Padding standar -->
    <Thickness x:Key="PaddingStandar">8</Thickness>
    
    <!-- Margin untuk seksi -->
    <Thickness x:Key="MarginSeksi">16</Thickness>
    
    <!-- Padding untuk window -->
    <Thickness x:Key="PaddingWindow">16</Thickness>


    <!-- ========================================
         STYLES
         ======================================== -->

    <!-- Style untuk Button -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WarnaPrimary}"/>
        <Setter Property="Foreground" Value="{StaticResource WarnaPrimaryForeground}"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" 
                                              Opacity="0.15" 
                                              BlurRadius="12" 
                                              ShadowDepth="2"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarnaTombolHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>

    <!-- Style untuk TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="BorderBrush" Value="{StaticResource WarnaBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource WarnaTombol}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style untuk ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarnaBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="#E8EAF0"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Grid.Column="0"
                                      Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0"
                                                              Margin="12,0,0,0"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                            <Path Grid.Column="1"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#1A1A1A"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="#E8EAF0"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource WarnaBorder}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,0,32,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          TextBlock.Foreground="#1A1A1A"
                                          TextBlock.FontWeight="Bold"
                                          TextBlock.FontSize="20"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="300">
                                <Border Background="#E8EAF0"
                                        BorderBrush="{StaticResource WarnaBorder}"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="16" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Style untuk ComboBoxItem -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="6"
                            Margin="2">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarnaAccent}"/>
                            <Setter Property="Foreground" Value="#1A1A1A"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarnaPrimary}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style untuk ListBox -->
    <Style TargetType="ListBox">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Style untuk ListBoxItem -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{StaticResource WarnaCard}"
                            BorderBrush="{StaticResource WarnaBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20,16"
                            Margin="{TemplateBinding Margin}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" 
                                              Opacity="0.1" 
                                              BlurRadius="10" 
                                              ShadowDepth="2" 
                                              Direction="270"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarnaAbu}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style untuk TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UkuranFontNormal}"/>
        <Setter Property="Foreground" Value="{StaticResource WarnaTeks}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
