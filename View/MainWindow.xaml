<Window x:Class="AplikasiAlarmWindows.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⏰ Alarm Windows - vickymosafan"
        Width="1100"
        Height="750"
        MinWidth="900"
        MinHeight="650"
        Background="{StaticResource WarnaLatar}"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AplikasiAlarmWindows;component/Resource/KamusGaya.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header Clock -->
            <RowDefinition Height="Auto"/> <!-- Input Section -->
            <RowDefinition Height="*"/>    <!-- Alarm List -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>
        
        <!-- ========================================
             HEADER - CLOCK DISPLAY (Row 0)
             ======================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource WarnaPrimary}"
                Padding="40,32">
            <Grid MaxWidth="1000" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Clock Icon -->
                <Viewbox Grid.Column="0" Width="80" Height="80" Margin="0,0,24,0">
                    <TextBlock Text="⏰" FontSize="80"/>
                </Viewbox>
                
                <!-- Time Display -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WaktuSekarang}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource WarnaPrimaryForeground}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- ========================================
             INPUT SECTION (Row 1)
             ======================================== -->
        <Border Grid.Row="1"
                Background="{StaticResource WarnaCard}"
                Padding="32,28"
                BorderBrush="{StaticResource WarnaBorder}"
                BorderThickness="0,0,0,1">
            <Grid MaxWidth="1000" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="➕ TAMBAH ALARM BARU"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource WarnaTeks}"
                           Margin="0,0,0,24"
                           HorizontalAlignment="Center"/>
                
                <!-- Input Controls -->
                <WrapPanel Grid.Row="1"
                           HorizontalAlignment="Center"
                           Orientation="Horizontal">
                    
                    <!-- Jam -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="JAM"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarnaTeksSecondary}"
                                   Margin="0,0,0,8"
                                   HorizontalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding DaftarJam}"
                                  SelectedItem="{Binding JamInput, Mode=TwoWay}"
                                  Width="110"
                                  HorizontalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Separator -->
                    <TextBlock Text=":"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource WarnaTeks}"
                               VerticalAlignment="Bottom"
                               Margin="0,0,16,8"/>
                    
                    <!-- Menit -->
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="MENIT"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarnaTeksSecondary}"
                                   Margin="0,0,0,8"
                                   HorizontalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding DaftarMenit}"
                                  SelectedItem="{Binding MenitInput, Mode=TwoWay}"
                                  Width="110"
                                  HorizontalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Suara -->
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="SUARA ALARM"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarnaTeksSecondary}"
                                   Margin="0,0,0,8"
                                   HorizontalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding DaftarFileSuara}"
                                  SelectedItem="{Binding FileSuaraTerpilih, Mode=TwoWay}"
                                  Width="220"/>
                    </StackPanel>
                    
                    <!-- Button -->
                    <Button Content="➕ TAMBAH"
                            Command="{Binding TambahAlarmCommand}"
                            VerticalAlignment="Bottom"
                            MinWidth="150"
                            Height="48"/>
                </WrapPanel>
                
                <!-- Validation Message -->
                <TextBlock Grid.Row="2"
                           Text="{Binding PesanValidasi}"
                           Foreground="{StaticResource WarnaDestructive}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
        
        <!-- ========================================
             ALARM LIST (Row 2)
             ======================================== -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource WarnaLatar}">
            <Grid MaxWidth="1000" 
                  HorizontalAlignment="Center"
                  Margin="32,24,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Section Title -->
                <TextBlock Grid.Row="0"
                           Text="📋 DAFTAR ALARM AKTIF"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource WarnaTeks}"
                           Margin="0,0,0,20"/>
                
                <!-- Alarm List -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding DaftarAlarm}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource WarnaCard}"
                                    BorderBrush="{StaticResource WarnaBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,16"
                                    Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" 
                                                      Opacity="0.2" 
                                                      BlurRadius="16" 
                                                      ShadowDepth="2"/>
                                </Border.Effect>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                            Background="{StaticResource WarnaAccent}"
                                            Width="64"
                                            Height="64"
                                            CornerRadius="12">
                                        <TextBlock Text="⏰"
                                                   FontSize="32"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Info -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="32"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource WarnaTeks}"/>
                                        <TextBlock Text="{Binding NamaFileSuara, StringFormat='🔊 {0}'}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource WarnaTeksSecondary}"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                    
                                    <!-- Active Badge -->
                                    <Border Grid.Column="4"
                                            Background="{StaticResource WarnaDestructive}"
                                            Padding="16,8"
                                            CornerRadius="20"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsAktif, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="🔔 AKTIF"
                                                   Foreground="{StaticResource WarnaDestructiveForeground}"
                                                   FontWeight="Bold"
                                                   FontSize="13"/>
                                    </Border>
                                    
                                    <!-- Delete Button -->
                                    <Button Grid.Column="6"
                                            Content="🗑️"
                                            Command="{Binding DataContext.HapusAlarmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="{StaticResource WarnaPrimary}"
                                            Foreground="#FFFFFF"
                                            BorderBrush="{StaticResource WarnaBorder}"
                                            BorderThickness="2"
                                            Width="56"
                                            Height="56"
                                            FontSize="20"
                                            Padding="0"
                                            MinWidth="56"
                                            ToolTip="Hapus Alarm"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Empty State -->
                <Border Grid.Row="1"
                        Background="{StaticResource WarnaCard}"
                        Padding="48,40"
                        CornerRadius="12"
                        BorderBrush="{StaticResource WarnaBorder}"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DaftarAlarm.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⏰"
                                   FontSize="72"
                                   HorizontalAlignment="Center"
                                   Opacity="0.3"
                                   Margin="0,0,0,20"/>
                        <TextBlock Text="BELUM ADA ALARM"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarnaTeks}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Tambahkan alarm pertama Anda menggunakan form di atas"
                                   FontSize="14"
                                   Foreground="{StaticResource WarnaTeksSecondary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"/>
                    </StackPanel>
                </Border>
                
                <!-- Stop Alarm Button -->
                <Button Grid.Row="2"
                        Content="🛑 STOP ALARM"
                        Command="{Binding StopAlarmCommand}"
                        Background="{StaticResource WarnaDestructive}"
                        HorizontalAlignment="Center"
                        MinWidth="250"
                        Height="56"
                        FontSize="18"
                        Margin="0,20,0,0"
                        Visibility="{Binding AdaAlarmAktif, Converter={StaticResource BoolToVisConverter}}"/>
            </Grid>
        </ScrollViewer>
        
        <!-- ========================================
             FOOTER (Row 3)
             ======================================== -->
        <Border Grid.Row="3"
                Background="{StaticResource WarnaCard}"
                Padding="20"
                BorderBrush="{StaticResource WarnaBorder}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <TextBlock Text="Made with ❤️ by "
                           FontSize="13"
                           Foreground="{StaticResource WarnaTeksSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="vickymosafan"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource WarnaPrimary}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
                <TextBlock Text=" © 2025"
                           FontSize="13"
                           Foreground="{StaticResource WarnaTeksSecondary}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
